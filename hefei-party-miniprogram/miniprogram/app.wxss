/* app.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
}

/* 导航栏标题 */
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #c0191f;
  padding: 24rpx 0 16rpx;
  border-bottom: 4rpx solid #c0191f;
  margin-bottom: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 按钮 */
.btn-primary {
  background: #c0191f;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-title {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.list-item-arrow {
  color: #ccc;
  font-size: 28rpx;
}

/* 红色主题 */
.theme-red {
  color: #c0191f;
}

.theme-red-bg {
  background-color: #c0191f;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-red {
  background: #fff0f0;
  color: #c0191f;
  border: 1rpx solid #c0191f;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}
