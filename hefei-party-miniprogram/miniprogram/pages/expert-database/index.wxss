.intro-card {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c0191f;
  padding: 16rpx 0 16rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: #c0191f;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.expert-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.expert-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.expert-avatar {
  width: 130rpx;
  height: 160rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.expert-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.expert-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.expert-title {
  font-size: 24rpx;
  color: #c0191f;
  margin-bottom: 10rpx;
  background: #fff0f0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  align-self: flex-start;
}

.expert-brief {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 20rpx;
  width: 85%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 40rpx 30rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  font-size: 50rpx;
  color: #999;
  line-height: 1;
}

.modal-avatar {
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  object-fit: cover;
}

.modal-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.modal-title {
  font-size: 26rpx;
  color: #c0191f;
  background: #fff0f0;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.modal-body {
  width: 100%;
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
}
