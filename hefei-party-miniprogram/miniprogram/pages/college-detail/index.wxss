.college-swiper {
  width: 100%;
  height: 380rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.content-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #c0191f;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c0191f;
  padding: 16rpx 0 12rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: #c0191f;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.dept-card {
  margin-bottom: 16rpx;
}

.dept-header {
  margin-bottom: 16rpx;
}

.dept-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  border-left: 6rpx solid #c0191f;
  padding-left: 12rpx;
}

.major-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.major-item {
  display: flex;
  align-items: center;
  background: #fff0f0;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.major-bullet {
  color: #c0191f;
  margin-right: 6rpx;
  font-size: 28rpx;
}

.major-name {
  font-size: 26rpx;
  color: #333;
}

.dept-intro {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  margin-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 12rpx;
}
