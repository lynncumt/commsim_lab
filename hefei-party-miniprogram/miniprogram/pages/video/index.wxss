.video-page {
  background: #000;
  min-height: 100vh;
}

.main-video {
  width: 100%;
  height: 100vh;
}

.video-list {
  background: #111;
  min-height: 100vh;
  padding: 20rpx;
}

.video-item {
  background: #222;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.video-thumb-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.video-thumb {
  width: 100%;
  height: 100%;
}

.play-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  font-size: 50rpx;
  color: #fff;
  margin-left: 8rpx;
}

.video-info {
  padding: 20rpx;
}

.video-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.video-desc {
  font-size: 24rpx;
  color: #aaa;
}

/* 全屏弹窗 */
.video-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #000;
  z-index: 999;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
}

.close-btn {
  color: #fff;
  font-size: 28rpx;
}

.popup-video {
  width: 100%;
  flex: 1;
}
