.header-banner {
  background: linear-gradient(135deg, #c0191f, #8b0000);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.banner-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}

.media-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.media-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.media-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.media-info {
  flex: 1;
}

.media-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.media-desc {
  font-size: 26rpx;
  color: #666;
}

.media-arrow {
  font-size: 44rpx;
  color: #ccc;
}
