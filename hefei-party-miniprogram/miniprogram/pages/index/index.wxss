/* 首页 */
.index-container {
  background: #f2f3f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ====== Banner ====== */
.banner {
  position: relative;
  width: 100%;
  height: 380rpx;
  background: linear-gradient(160deg, #c0191f 0%, #7a0000 100%);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}

.banner-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.banner-title {
  font-size: 50rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.45);
  letter-spacing: 8rpx;
}

.banner-subtitle {
  font-size: 30rpx;
  color: rgba(255,255,255,0.92);
  margin-top: 16rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 1rpx 8rpx rgba(0,0,0,0.3);
}

/* ====== 7个模块列表（纯文字，符合文档示意图）====== */
.module-list {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.module-item {
  display: flex;
  align-items: center;
  padding: 34rpx 28rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.module-item.last {
  border-bottom: none;
}

/* 左侧红色竖条，对应文档列表样式 */
.module-bar {
  width: 6rpx;
  height: 36rpx;
  background: #c0191f;
  border-radius: 3rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.module-name {
  flex: 1;
  font-size: 32rpx;
  color: #222;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.module-arrow {
  font-size: 46rpx;
  color: #c0191f;
  line-height: 1;
  margin-left: 12rpx;
}

/* ====== 合城动态标题 ====== */
.section-header {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx 16rpx;
  gap: 14rpx;
}

.section-bar {
  width: 7rpx;
  height: 34rpx;
  background: #c0191f;
  border-radius: 3rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
}

/* ====== 合城动态列表 ====== */
.news-wrap {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.news-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
  gap: 18rpx;
}

.news-item:last-child {
  border-bottom: none;
}

.news-thumb {
  width: 160rpx;
  height: 110rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.news-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}

.news-title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-date {
  font-size: 22rpx;
  color: #aaa;
}

.news-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
}

.news-loading,
.news-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #bbb;
  font-size: 26rpx;
}

/* ====== 底部标语 ====== */
.footer-slogan {
  text-align: center;
  color: #bbb;
  font-size: 22rpx;
  padding: 30rpx 0 10rpx;
}
