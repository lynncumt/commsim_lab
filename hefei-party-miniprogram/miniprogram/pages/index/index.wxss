/* 首页 */
.index-container {
  background: #f2f3f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ====== Hero Banner ====== */
.banner {
  position: relative;
  width: 100%;
  height: 400rpx;
  background: linear-gradient(160deg, #c0191f 0%, #7a0000 100%);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}

.banner-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.banner-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 14rpx rgba(0,0,0,0.45);
  letter-spacing: 8rpx;
}

.banner-subtitle {
  font-size: 30rpx;
  color: rgba(255,255,255,0.92);
  margin-top: 16rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 1rpx 8rpx rgba(0,0,0,0.3);
}

/* ====== 7模块导航网格 ====== */
.grid-section {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 10rpx 0 16rpx;
  box-shadow: 0 2rpx 14rpx rgba(0,0,0,0.07);
  overflow: hidden;
}

.grid-row {
  display: flex;
  flex-direction: row;
}

/* 3列网格项 */
.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 10rpx 24rpx;
  position: relative;
}

.grid-item::after {
  content: '';
  position: absolute;
  right: 0; top: 20%; bottom: 20%;
  width: 1rpx;
  background: #f0f0f0;
}

.grid-item:last-child::after {
  display: none;
}

.grid-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 14rpx;
  /* 无图时用红色圆形占位 */
  background: #fff0f0;
  border-radius: 16rpx;
}

.grid-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  line-height: 1.4;
}

/* 第三行全宽项（联系我们）*/
.grid-item-full {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 26rpx 32rpx;
  margin: 10rpx 20rpx 4rpx;
  background: linear-gradient(135deg, #c0191f 0%, #9b1010 100%);
  border-radius: 12rpx;
  gap: 16rpx;
}

.grid-icon-sm {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 10rpx;
  flex-shrink: 0;
}

.grid-name-full {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 1rpx;
}

.grid-arrow {
  font-size: 44rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1;
}

/* 行间分隔线 */
.grid-row:first-child {
  border-bottom: 1rpx solid #f5f5f5;
}

.grid-row:nth-child(2) {
  border-bottom: 1rpx solid #f5f5f5;
}

/* ====== 合城动态 ====== */
.section-header {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx 16rpx;
  gap: 14rpx;
}

.section-bar {
  width: 7rpx;
  height: 34rpx;
  background: #c0191f;
  border-radius: 3rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
}

.news-wrap {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 14rpx rgba(0,0,0,0.07);
}

.news-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
  gap: 18rpx;
}

.news-item:last-child {
  border-bottom: none;
}

.news-thumb {
  width: 160rpx;
  height: 110rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.news-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}

.news-title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-date {
  font-size: 22rpx;
  color: #aaa;
}

.news-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
}

.news-loading, .news-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #bbb;
  font-size: 26rpx;
}

/* ====== 底部标语 ====== */
.footer-slogan {
  text-align: center;
  color: #bbb;
  font-size: 22rpx;
  padding: 28rpx 0 10rpx;
}
