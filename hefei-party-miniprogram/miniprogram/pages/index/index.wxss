/* 首页 */
.index-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* Banner */
.banner {
  position: relative;
  width: 100%;
  background: linear-gradient(135deg, #c0191f 0%, #8b0000 100%);
  overflow: hidden;
  min-height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-img {
  width: 100%;
  display: block;
  min-height: 240rpx;
}

.banner-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.banner-title {
  font-size: 46rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.35);
  letter-spacing: 4rpx;
}

.banner-subtitle {
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

/* 7个模块列表 */
.module-list {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.07);
  overflow: hidden;
}

.module-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.module-item.last {
  border-bottom: none;
}

.module-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.module-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c0191f;
  flex-shrink: 0;
}

.module-name {
  font-size: 32rpx;
  color: #222;
  font-weight: 500;
}

.module-arrow {
  font-size: 44rpx;
  color: #bbb;
  line-height: 1;
}

/* 合城动态 */
.section-header {
  padding: 32rpx 30rpx 16rpx;
  display: flex;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c0191f;
  padding-left: 16rpx;
  border-left: 6rpx solid #c0191f;
}

.news-list {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.07);
}

.news-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f2f2f2;
  gap: 20rpx;
}

.news-item:last-child {
  border-bottom: none;
}

.news-thumb {
  width: 160rpx;
  height: 110rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.news-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.news-title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-date {
  font-size: 22rpx;
  color: #aaa;
}

.news-loading,
.news-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #bbb;
  font-size: 26rpx;
}
