/* 首页 */
.index-container {
  background: #f2f3f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ====== Banner ====== */
.banner {
  position: relative;
  width: 100%;
  height: 380rpx;
  /* 无图时的渐变兜底，有图时被图片覆盖 */
  background: linear-gradient(160deg, #c0191f 0%, #7a0000 100%);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}

.banner-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.banner-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.4);
  letter-spacing: 6rpx;
}

.banner-subtitle {
  font-size: 30rpx;
  color: rgba(255,255,255,0.92);
  margin-top: 14rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.3);
}

/* ====== 7个模块列表 ====== */
.module-list {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.07);
}

.module-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 18rpx;
}

.module-item.last {
  border-bottom: none;
}

.module-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: #fff5f5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.module-icon {
  font-size: 36rpx;
  line-height: 1;
}

.module-name {
  flex: 1;
  font-size: 30rpx;
  color: #222;
  font-weight: 500;
}

.module-arrow {
  font-size: 44rpx;
  color: #c0191f;
  font-weight: bold;
  line-height: 1;
}

/* ====== 合城动态 ====== */
.section-header {
  padding: 30rpx 30rpx 16rpx;
  display: flex;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
  padding-left: 18rpx;
  border-left: 7rpx solid #c0191f;
}

.news-wrap {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.07);
}

.news-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 18rpx;
}

.news-item:last-child {
  border-bottom: none;
}

.news-thumb {
  width: 160rpx;
  height: 108rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.news-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}

.news-title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-date {
  font-size: 22rpx;
  color: #aaa;
}

.news-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
}

.news-loading,
.news-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #bbb;
  font-size: 26rpx;
}

/* ====== 底部标语 ====== */
.footer-slogan {
  text-align: center;
  color: #bbb;
  font-size: 22rpx;
  padding: 30rpx 0 10rpx;
}
