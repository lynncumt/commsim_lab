/* 首页样式 */
.index-container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* Banner */
.banner {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(135deg, #c0191f 0%, #8b0000 100%);
}

.banner-img {
  width: 100%;
  display: block;
}

.banner-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  display: flex;
  flex-direction: column;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.banner-subtitle {
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
}

/* 无图片时的banner占位 */
.banner-placeholder {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, #c0191f 0%, #8b0000 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.banner-placeholder .banner-title,
.banner-placeholder .banner-subtitle {
  color: #fff;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c0191f;
  padding: 24rpx 30rpx 16rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: #c0191f;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

/* 主网格 */
.main-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx 10rpx;
  gap: 16rpx;
}

.grid-item {
  width: calc(33.33% - 12rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}

.grid-item.full-width {
  width: 100%;
  flex-direction: row;
  justify-content: center;
  padding: 24rpx;
  gap: 16rpx;
}

.grid-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
  line-height: 1;
}

.grid-item.full-width .grid-icon {
  margin-bottom: 0;
  font-size: 56rpx;
}

.grid-text {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  line-height: 1.4;
}

.grid-item.full-width .grid-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #c0191f;
}

/* 新闻列表 */
.news-list {
  margin: 0 20rpx;
}

.news-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.news-item:last-child {
  border-bottom: none;
}

.news-content {
  flex: 1;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
}

.news-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-date {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.news-thumb {
  width: 160rpx;
  height: 110rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  object-fit: cover;
}

/* 附设栏目 */
.sub-nav {
  display: flex;
  margin: 0 20rpx 20rpx;
  gap: 16rpx;
}

.sub-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.sub-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.sub-text {
  font-size: 24rpx;
  color: #333;
}

/* 页脚 */
.footer {
  text-align: center;
  padding: 30rpx 0 50rpx;
  font-size: 24rpx;
  color: #999;
}
