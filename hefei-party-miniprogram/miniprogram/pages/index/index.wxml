<!-- 首页 -->
<view class="index-container">

  <!-- Hero Banner -->
  <view class="banner">
    <image class="banner-bg" src="../../images/banner.png" mode="aspectFill" />
    <view class="banner-content">
      <text class="banner-title">合肥城市学院</text>
      <text class="banner-subtitle">校企党建互助</text>
    </view>
  </view>

  <!-- 7个模块导航网格 -->
  <view class="grid-section">
    <!-- 第一行：3个 -->
    <view class="grid-row">
      <view class="grid-item" bindtap="goTo" data-url="/pages/school-overview/index">
        <image class="grid-icon" src="../../images/icon-school.png" mode="aspectFit" />
        <text class="grid-name">学校概况</text>
      </view>
      <view class="grid-item" bindtap="goTo" data-url="/pages/party-intro/index">
        <image class="grid-icon" src="../../images/icon-party.png" mode="aspectFit" />
        <text class="grid-name">党建互助简介</text>
      </view>
      <view class="grid-item" bindtap="goTo" data-url="/pages/party-resources/index">
        <image class="grid-icon" src="../../images/icon-resource.png" mode="aspectFit" />
        <text class="grid-name">党建思政资源</text>
      </view>
    </view>
    <!-- 第二行：3个 -->
    <view class="grid-row">
      <view class="grid-item" bindtap="goTo" data-url="/pages/expert-database/index">
        <image class="grid-icon" src="../../images/icon-expert.png" mode="aspectFit" />
        <text class="grid-name">思政专家库</text>
      </view>
      <view class="grid-item" bindtap="goTo" data-url="/pages/courses/index">
        <image class="grid-icon" src="../../images/icon-course.png" mode="aspectFit" />
        <text class="grid-name">精品课程库</text>
      </view>
      <view class="grid-item" bindtap="goTo" data-url="/pages/cases/index">
        <image class="grid-icon" src="../../images/icon-case.png" mode="aspectFit" />
        <text class="grid-name">互助案例采撷</text>
      </view>
    </view>
    <!-- 第三行：1个全宽（联系我们） -->
    <view class="grid-row">
      <view class="grid-item-full" bindtap="goTo" data-url="/pages/contact/index">
        <image class="grid-icon-sm" src="../../images/icon-contact.png" mode="aspectFit" />
        <text class="grid-name-full">党建互助 · 联系我们</text>
        <text class="grid-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 合城动态 -->
  <view class="section-header">
    <view class="section-bar"></view>
    <text class="section-title">合城动态</text>
  </view>

  <view class="news-wrap">
    <view class="news-loading" wx:if="{{loading}}"><text>加载中...</text></view>
    <block wx:elif="{{newsList.length > 0}}">
      <view class="news-item" wx:for="{{newsList}}" wx:key="_id" bindtap="goToCase" data-id="{{item._id}}">
        <image wx:if="{{item.coverImage}}" class="news-thumb" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="news-body">
          <text class="news-title">{{item.title}}</text>
          <text class="news-date">{{item.date}}</text>
        </view>
        <text class="news-arrow">›</text>
      </view>
    </block>
    <view wx:else class="news-empty">暂无动态</view>
  </view>

  <view class="footer-slogan">协力同心强党建 · 校企同频谱新篇</view>

</view>
