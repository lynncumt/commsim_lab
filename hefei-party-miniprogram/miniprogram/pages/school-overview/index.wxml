<!-- 学校概况 -->
<view class="container">
  <!-- 学校简介 -->
  <view class="card intro-card">
    <view class="card-title">合肥城市学院简况</view>
    <block wx:if="{{overview.images && overview.images.length > 0}}">
      <swiper class="intro-swiper" autoplay circular indicator-dots>
        <swiper-item wx:for="{{overview.images}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill" class="intro-img" />
        </swiper-item>
      </swiper>
    </block>
    <view class="intro-content">
      <rich-text nodes="{{overview.content || '暂无内容'}}"></rich-text>
    </view>
  </view>

  <!-- 四个二级学院 -->
  <view class="section-title">二级学院</view>
  <view class="college-list">
    <view class="college-item card" wx:for="{{colleges}}" wx:key="_id" bindtap="goToCollege" data-id="{{item._id}}" data-name="{{item.name}}">
      <image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" class="college-img" mode="aspectFill" />
      <view class="college-info">
        <text class="college-name">{{item.name}}</text>
        <text class="college-desc">{{item.brief}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
