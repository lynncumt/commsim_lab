<!-- 校企党建互助案例采撷 -->
<view class="container">
  <view class="loading-wrap" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view wx:else>
    <view class="cases-list" wx:if="{{cases.length > 0}}">
      <view class="case-item card" wx:for="{{cases}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
        <image wx:if="{{item.coverImage}}" class="case-img" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="case-content">
          <text class="case-title">{{item.title}}</text>
          <text class="case-summary">{{item.summary}}</text>
          <view class="case-footer">
            <text class="case-date">{{item.dateStr}}</text>
            <text class="case-more">阅读全文 ›</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-tip">暂无案例</view>
  </view>

  <!-- 加载更多 -->
  <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
    <text>加载更多</text>
  </view>
</view>
