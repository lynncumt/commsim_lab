.cases-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.case-item {
  overflow: hidden;
  padding: 0;
}

.case-img {
  width: 100%;
  height: 320rpx;
  display: block;
  object-fit: cover;
}

.case-content {
  padding: 24rpx;
}

.case-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.case-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.case-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.case-date {
  font-size: 24rpx;
  color: #999;
}

.case-more {
  font-size: 26rpx;
  color: #c0191f;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  color: #c0191f;
  font-size: 28rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}
