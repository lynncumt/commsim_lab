.intro-card {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.category-block {
  margin-bottom: 24rpx;
}

.category-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0 12rpx;
}

.category-num {
  background: #c0191f;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.category-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.course-list {
  padding: 8rpx 24rpx;
}

.course-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.course-item:last-child {
  border-bottom: none;
}

.course-index {
  font-size: 28rpx;
  color: #999;
  width: 36rpx;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.course-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.course-teacher {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.play-btn {
  color: #c0191f;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 20rpx;
  width: 85%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 40rpx 30rpx;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  font-size: 50rpx;
  color: #999;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  padding-right: 40rpx;
}

.modal-sub {
  font-size: 26rpx;
  color: #c0191f;
  display: block;
  margin-bottom: 20rpx;
}

.modal-body {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.btn-play {
  background: #c0191f;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  text-align: center;
  width: 100%;
  border: none;
  padding: 18rpx 0;
}

.btn-play::after {
  border: none;
}
