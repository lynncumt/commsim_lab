.card-header {
  background: linear-gradient(135deg, #c0191f, #8b0000);
  border-radius: 12rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.slogan {
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 1.6;
}

.section-block {
  margin-bottom: 30rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-block:last-child {
  border-bottom: none;
}

.block-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #c0191f;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c0191f;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.project-item {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.project-num {
  background: #c0191f;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.project-info {
  flex: 1;
}

.project-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.project-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}
