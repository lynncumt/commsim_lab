.header-banner {
  background: linear-gradient(135deg, #c0191f, #8b0000);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.5;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.5;
}

.form-section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.need-category {
  margin-bottom: 24rpx;
}

.need-cat-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #c0191f;
  margin-bottom: 12rpx;
}

.need-items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.need-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  border: 2rpx solid #e0e0e0;
  background: #fafafa;
  transition: all 0.2s;
}

.need-item.selected {
  border-color: #c0191f;
  background: #fff0f0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #c0191f;
}

.checkbox.checked {
  background: #c0191f;
  border-color: #c0191f;
  color: #fff;
}

.need-label {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  line-height: 1.5;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.required {
  color: #c0191f;
}

.form-input {
  width: 100%;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  height: 200rpx;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-btn {
  background: #c0191f;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  text-align: center;
  padding: 24rpx;
  width: 100%;
  border: none;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(192, 25, 31, 0.35);
}

.submit-btn::after {
  border: none;
}

.footer-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0 40rpx;
}
